{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
    },
  "ConnectionStrings": {
    "BookingDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5174" ]
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Confirm": false,
    "Email": "",
    "FirstName": "",
    "LastName": "",
    "Password": ""
  },
  "AllowedHosts": "*"
}
